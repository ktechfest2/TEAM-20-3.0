# Do not commit actual secrets. Agent must verify official variable conventions for installed SDKs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VISION_PROVIDER=manual
VISION_API_KEY=
# Never expose service-role or vision keys via NEXT_PUBLIC_

# --- Evidence backend (server-only; never prefix with NEXT_PUBLIC_) ---
# HMAC key for the signed pt_session cookie. REQUIRED in production, >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in development, a DEV-ONLY secret is generated and kept in .data/.session-secret.
POLLTRACE_SESSION_SECRET=
# Synthetic demo reviewer identities ("Synthetic Demo Reviewer A/B"). Off unless exactly 1.
POLLTRACE_DEMO_REVIEWERS=0
# Required (in production) to sign in as a demo reviewer when the flag above is 1.
POLLTRACE_DEMO_REVIEWER_PASSCODE=
# LOCAL_DEV evidence store (JSON + files) is refused when NODE_ENV=production unless this is 1.
# Responses label storageMode LOCAL_DEV either way. Leave 0 for real deployments.
POLLTRACE_ALLOW_LOCAL_STORE=0
# Optional override for the LOCAL_DEV data directory (default ./.data, gitignored).
POLLTRACE_LOCAL_DATA_DIR=
# Guided /demo presenter passcode (server-only). Demo stage/reset endpoints are disabled unless this
# is set AND POLLTRACE_DEMO_REVIEWERS=1. Never prefix with NEXT_PUBLIC_; never commit a value.
POLLTRACE_DEMO_ADMIN_PASSCODE=
